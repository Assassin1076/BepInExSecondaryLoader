<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>BepInExSecondaryLoader</AssemblyName>
    <Product>BepInExSecondaryLoader</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>BepInExSecondaryLoader</RootNamespace>

	  <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Mono.Cecil" Version="0.10.4" ExcludeAssets="runtime" NoWarn="NU1605" />
		<PackageReference Include="HarmonyX" Version="2.9.0" ExcludeAssets="runtime" NoWarn="NU1605" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.6" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Publicize Include="Assembly-CSharp" IncludeCompilerGeneratedMembers="false" />
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="com.rlabrecque.steamworks.net">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
		</Reference>
		<Reference Include="ConfigurationManager">
			<HintPath>$(GameDir)\BepInEx\bak\ConfigurationManager\ConfigurationManager.dll</HintPath>
		</Reference>
		<Reference Include="Mirage">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\Mirage.dll</HintPath>
		</Reference>
		<Reference Include="StandaloneFileBrowser">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\StandaloneFileBrowser.dll</HintPath>
		</Reference>
		<Reference Include="UniTask">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\UniTask.dll</HintPath>
		</Reference>
		<Reference Include="netstandard">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\netstandard.dll</HintPath>
		</Reference>
		<Publicize Include="Rewired_Core" />
		<Reference Include="Rewired_Core">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\Rewired_Core.dll</HintPath>
		</Reference>
		<Reference Include="Unity.RenderPipelines.Core.Runtime">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Unity.RenderPipelines.Universal.Runtime">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(GameDir)\NuclearOption_Data\Managed\UnityEngine.UI.dll</HintPath>
		</Reference>
	</ItemGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">

		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>

		<!-- 清理路径 -->
		<PathMap>
			$(MSBuildProjectDirectory)=/
		</PathMap>

		<!-- 稳定构建 -->
		<Deterministic>true</Deterministic>

	</PropertyGroup>
</Project>
